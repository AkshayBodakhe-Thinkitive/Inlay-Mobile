# ---------------------------------------------------------------------------------------
# Environment configuration. Create your local file with:  cp .env.example .env
#
# WARNING: every EXPO_PUBLIC_ value is built into the app bundle and can be read by anyone
# who has the app. NEVER put secrets, API keys or tokens in this file.
#
# After editing .env, fully reload the app. If a value looks stale, restart Metro with
# `npx expo start -c`. EAS cloud builds do NOT receive this file: set the same keys in the
# matching profile's "env" block in eas.json.
#
# Every key is read in src/shared/config/env.ts, and nowhere else.
# ---------------------------------------------------------------------------------------

# Environment a fresh install starts on. Accepts: dev | qa | uat | production.
# Anything else is treated as dev, never production.
# Profiles: development=dev, qa=qa, uat=uat, production=production.
EXPO_PUBLIC_DEFAULT_ENV=dev

# API base URLs, one per environment. No trailing slash needed (it is stripped).
# If a key is missing, a placeholder URL from src/shared/config/environments.ts is used.
# These are placeholders: replace them with the real hosts.
EXPO_PUBLIC_API_BASE_URL_DEV=https://dev-api.inlay.example.com
EXPO_PUBLIC_API_BASE_URL_QA=https://qa-api.inlay.example.com
EXPO_PUBLIC_API_BASE_URL_UAT=https://uat-api.inlay.example.com
EXPO_PUBLIC_API_BASE_URL_PROD=https://api.inlay.example.com

# Mock mode: services return sample data and never call the network.
# Accepts: true | false (anything but "true" is false).
# On in: development. Off in: qa, uat, production (flip qa on in eas.json while there is no backend).
EXPO_PUBLIC_USE_MOCK=true

# Feature flags: accept true | false. Off by default; anything but "true" is off.
# A flag hides the feature's entry point; when off, the feature is unreachable.

# "Forgot password?" link on Sign in. On in: development. Off in: qa, uat, production.
EXPO_PUBLIC_ENABLE_FORGOT_PASSWORD=false

# "Sign in with Face ID" button on Sign in. On in: development. Off in: qa, uat, production.
EXPO_PUBLIC_ENABLE_FACE_ID_SIGN_IN=false
